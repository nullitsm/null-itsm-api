# NULL ITSM API — environment template.
# Copy to .env for local development. NEVER commit a real .env, and NEVER
# put real secrets in this repo. Production secrets come from AWS Secrets
# Manager (see infra/terraform). Keep dev and production credentials separate.

# --- Application ---
NULL_ENV=development
NULL_DEBUG=false
NULL_API_HOST=0.0.0.0
NULL_API_PORT=8000
# Secret used to sign dev-issued JWTs. REQUIRED in every environment.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NULL_JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
NULL_JWT_ALGORITHM=HS256
NULL_ACCESS_TOKEN_MINUTES=15
NULL_REFRESH_TOKEN_DAYS=7
NULL_MFA_TOKEN_MINUTES=5
NULL_PASSWORD_RESET_MINUTES=60
NULL_INVITATION_DAYS=7

# --- Database (PostgreSQL) ---
# App role (subject to Row-Level Security). Migrations/seed use the owner role.
NULL_DATABASE_URL=postgresql+psycopg://null_app:CHANGE_ME@localhost:5432/null_itsm
NULL_DATABASE_OWNER_URL=postgresql+psycopg://null_owner:CHANGE_ME@localhost:5432/null_itsm
NULL_DB_POOL_SIZE=10
NULL_DB_MAX_OVERFLOW=10

# --- Redis / Celery ---
NULL_REDIS_URL=redis://localhost:6379/0
NULL_CELERY_BROKER_URL=redis://localhost:6379/1
NULL_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- OIDC (AWS Cognito in production; leave blank for local dev JWT issuer) ---
# When OIDC_ISSUER is set, access tokens are verified as RS256 OIDC ID/access
# tokens against the issuer's JWKS instead of the local HS256 secret.
NULL_OIDC_ISSUER=
NULL_OIDC_AUDIENCE=
NULL_OIDC_JWKS_URL=
# Cognito user pool id (informational; the issuer URL is authoritative)
NULL_COGNITO_USER_POOL_ID=

# --- S3 file storage ---
NULL_S3_BUCKET=
NULL_S3_REGION=us-east-1
NULL_S3_ENDPOINT_URL=
NULL_AWS_ACCESS_KEY_ID=
NULL_AWS_SECRET_ACCESS_KEY=

# --- Email (dev: logged, never sent) ---
NULL_EMAIL_FROM=no-reply@nullitsm.local
NULL_SMTP_HOST=
NULL_SMTP_PORT=587
NULL_SMTP_USER=
NULL_SMTP_PASSWORD=

# --- Dev fixtures (NEVER enable in production) ---
# Seeds two clearly-labelled test organizations (Acme IT Services, Globex
# Manufacturing) with separate administrators and technicians, for tests and
# local development only.
NULL_SEED_DEV_FIXTURES=false

# --- Rate limiting ---
NULL_RATE_LIMIT_AUTH=10/minute
